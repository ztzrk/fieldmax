{
    "compilerOptions": {
        /* Projects */
        "target": "es2016",
        "lib": ["es6"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,

        /* Modules */
        "module": "commonjs",
        "rootDir": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "resolveJsonModule": true,

        /* JavaScript Support */
        "allowJs": true,

        /* Emit */
        "outDir": "dist",

        /* Interop Constraints */
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,

        /* Completeness */
        "skipLibCheck": true
    },
    "include": ["src/**/*", "prisma/**/*"],
    "ts-node": {
        "require": ["tsconfig-paths/register"]
    }
}
